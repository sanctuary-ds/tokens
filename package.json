{
  "name": "@sanctuary-ds/tokens",
  "version": "0.1.1",
  "description": "Sanctuary: a design system of stone, glass and light.",
  "license": "MIT",
  "author": {
    "name": "Anthony Portugal",
    "url": "https://anthonyportugal.github.io"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "oklch",
    "css-custom-properties",
    "color-palette",
    "dark-theme",
    "theme",
    "ricing"
  ],
  "homepage": "https://sanctuary-ds.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanctuary-ds/tokens.git"
  },
  "bugs": {
    "url": "https://github.com/sanctuary-ds/tokens/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check",
    "api": "node scripts/api.js",
    "test": "node --test"
  },
  "exports": {
    "./css": "./dist/css/sanctuary.css",
    "./palette": "./dist/palette.json",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "publishConfig": {
    "access": "public"
  }
}
