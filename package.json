{
  "name": "@sanctuary-ds/tokens",
  "version": "0.3.0",
  "description": "Sanctuary: a design system of stone, glass and light.",
  "license": "MIT",
  "author": {
    "name": "Anthony Portugal",
    "url": "https://anthonyportugal.github.io"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "oklch",
    "css-custom-properties",
    "color-palette",
    "dark-theme",
    "theme",
    "ricing"
  ],
  "homepage": "https://sanctuary-ds.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanctuary-ds/tokens.git"
  },
  "bugs": {
    "url": "https://github.com/sanctuary-ds/tokens/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check",
    "api": "node scripts/api.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc"
  },
  "exports": {
    "./css": "./dist/css/sanctuary.css",
    "./palette": {
      "types": "./dist/palette.d.ts",
      "default": "./dist/palette.js"
    },
    "./palette.json": "./dist/palette.json",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "tokens"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
